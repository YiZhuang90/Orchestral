<UserControl x:Class="ExperimentalControlPlatform.App.Widgets.LifecycleActionRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:ExperimentalControlPlatform.App.Widgets"
             x:Name="LifecycleActionRoot"
             Visibility="Collapsed">
  <UserControl.Resources>
    <widgets:LifecycleActionRowLabelConverter x:Key="LifecycleActionRowLabelConverter" />
  </UserControl.Resources>
  <ItemsControl ItemsSource="{Binding SupportedLifecycleActions, RelativeSource={RelativeSource AncestorType={x:Type widgets:LifecycleActionRow}}}"
                HorizontalAlignment="Stretch">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Button Margin="0,0,0,8"
                Command="{Binding LifecycleActionCommand, RelativeSource={RelativeSource AncestorType={x:Type widgets:LifecycleActionRow}}}"
                CommandParameter="{Binding}"
                Content="{Binding Converter={StaticResource LifecycleActionRowLabelConverter}}"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentActionButtonStyle}" />
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
