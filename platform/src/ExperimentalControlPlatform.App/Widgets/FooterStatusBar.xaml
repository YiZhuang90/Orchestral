<UserControl x:Class="ExperimentalControlPlatform.App.Widgets.FooterStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="FooterRoot">
  <Border Height="36"
          Background="{StaticResource WindowBackgroundBrush}"
          BorderBrush="{StaticResource FooterDividerBrush}"
          BorderThickness="0,1,0,0"
          CornerRadius="0,0,15,15">
    <Grid Margin="18,0,18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ContentPresenter VerticalAlignment="Center"
                        Content="{Binding LeftContent, ElementName=FooterRoot}"
                        DataContext="{Binding DataContext, ElementName=FooterRoot}" />

      <ContentPresenter Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{Binding RightContent, ElementName=FooterRoot}"
                        DataContext="{Binding DataContext, ElementName=FooterRoot}" />
    </Grid>
  </Border>
</UserControl>
