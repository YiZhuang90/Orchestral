<UserControl x:Class="ExperimentalControlPlatform.App.Widgets.RealTimeValueHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Orientation="Horizontal"
              VerticalAlignment="Center">
    <TextBlock FontFamily="{StaticResource BodyFontFamily}"
               FontSize="{StaticResource FontBody}"
               Foreground="{StaticResource TextSecondaryBrush}"
               VerticalAlignment="Bottom"
               Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    <TextBlock Margin="8,0,0,0"
               FontFamily="{StaticResource ShellFontFamily}"
               FontSize="{StaticResource FontDisplayValue}"
               Foreground="{StaticResource AccentBrush}"
               VerticalAlignment="Center"
               Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" />
  </StackPanel>
</UserControl>
