<UserControl x:Class="ExperimentalControlPlatform.App.ExperimentMonitor.ExperimentMonitorPanelTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:shells="clr-namespace:ExperimentalControlPlatform.App.Shell"
             xmlns:widgets="clr-namespace:ExperimentalControlPlatform.App.Widgets">
  <shells:DevicePanelShell PanelTitle="{Binding Title}"
                           ContextLabel="Experiment plane"
                           LeftRailWidth="260">
    <shells:DevicePanelShell.LeftRailContent>
      <widgets:DeviceControlPanel>
        <widgets:DeviceControlPanel.ConfigurationContent>
          <StackPanel>
            <TextBlock FontSize="{StaticResource FontMicro}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Run index" />
            <Border Margin="0,6,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}">
              <TextBox Style="{StaticResource TextBoxStyle}"
                       Text="{Binding RunIndexDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>

            <TextBlock Margin="0,10,0,0"
                       FontSize="{StaticResource FontMicro}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Primary target" />
            <Border Margin="0,6,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}">
              <TextBox Style="{StaticResource TextBoxStyle}"
                       Text="{Binding PrimaryTargetDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>

            <TextBlock Margin="0,10,0,0"
                       FontSize="{StaticResource FontMicro}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Operator note" />
            <Border Margin="0,6,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}">
              <TextBox Style="{StaticResource TextBoxStyle}"
                       Text="{Binding OperatorNoteDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>

            <TextBlock Margin="0,10,0,0"
                       FontSize="{StaticResource FontMicro}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Display rate" />
            <Border Margin="0,6,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}">
              <ComboBox Style="{StaticResource ComboBoxStyle}"
                        ItemsSource="{Binding DisplayRateOptions}"
                        SelectedItem="{Binding SelectedDisplayRateHz, Mode=TwoWay}" />
            </Border>

            <TextBlock Margin="0,16,0,0"
                       FontSize="{StaticResource FontMicro}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding InitializationStatus}" />
          </StackPanel>
        </widgets:DeviceControlPanel.ConfigurationContent>

        <widgets:DeviceControlPanel.ActionsContent>
          <StackPanel Margin="0,16,0,0">
            <TextBlock FontSize="{StaticResource FontMicro}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Run controls" />

            <StackPanel Margin="0,6,0,0">
              <Button Margin="0,0,0,6"
                      Style="{StaticResource AccentActionButtonStyle}"
                      Click="InitializeButton_OnClick">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <iconPacks:PackIconMaterial Margin="0,0,8,0"
                                              Kind="PowerPlug"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center" />
                  <TextBlock Text="Initialize" />
                </StackPanel>
              </Button>

              <Button Margin="0,0,0,6"
                      Style="{StaticResource OutlineActionButtonStyle}"
                      Click="StartButton_OnClick"
                      IsEnabled="{Binding CanStart}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <iconPacks:PackIconMaterial Margin="0,0,8,0"
                                              Kind="Play"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center" />
                  <TextBlock Text="Start" />
                </StackPanel>
              </Button>

              <Button Style="{StaticResource SoftActionButtonStyle}"
                      Click="StopButton_OnClick"
                      IsEnabled="{Binding CanStop}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <iconPacks:PackIconMaterial Margin="0,0,8,0"
                                              Kind="Stop"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center" />
                  <TextBlock Text="Stop" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </widgets:DeviceControlPanel.ActionsContent>
      </widgets:DeviceControlPanel>
    </shells:DevicePanelShell.LeftRailContent>

    <shells:DevicePanelShell.WorkspaceContent>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <widgets:StatisticsPanel Grid.Row="0"
                                 Margin="0,0,0,12"
                                 Columns="3"
                                 ItemsSource="{Binding SummaryCards}" />

        <widgets:DataPanel Grid.Row="1"
                           Margin="0,0,0,12">
          <widgets:DataPanel.HeaderContent>
            <TextBlock FontFamily="{StaticResource ShellFontFamily}"
                       FontSize="{StaticResource FontSectionHeader}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Live summary" />
          </widgets:DataPanel.HeaderContent>
          <widgets:DataPanel.PlotContent>
            <Border Margin="14,0,14,14"
                    Background="{StaticResource WindowBackgroundBrush}"
                    BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}"
                    Padding="14">
              <TextBlock Text="{Binding LiveSummary}"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
          </widgets:DataPanel.PlotContent>
        </widgets:DataPanel>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource SoftBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusPanel}"
                  Padding="14"
                  Margin="0,0,12,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <TextBlock FontFamily="{StaticResource ShellFontFamily}"
                         FontSize="{StaticResource FontSectionHeader}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="Monitor stream" />

              <ListBox Grid.Row="1"
                       Margin="0,12,0,0"
                       Background="Transparent"
                       BorderThickness="0"
                       ItemsSource="{Binding DisplayItems}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            Background="{StaticResource WindowBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}">
                      <StackPanel>
                        <TextBlock FontFamily="{StaticResource BodyFontFamily}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Severity}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding Source}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource SoftBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusPanel}"
                  Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <TextBlock FontFamily="{StaticResource ShellFontFamily}"
                         FontSize="{StaticResource FontSectionHeader}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Text="Devices" />

              <ListBox Grid.Row="1"
                       Margin="0,12,0,0"
                       Background="Transparent"
                       BorderThickness="0"
                       ItemsSource="{Binding DeviceSnapshots}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            Background="{StaticResource WindowBackgroundBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}">
                      <StackPanel>
                        <TextBlock FontFamily="{StaticResource BodyFontFamily}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding StatusMessage}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding SessionFamily}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </shells:DevicePanelShell.WorkspaceContent>

    <shells:DevicePanelShell.FooterContent>
      <widgets:FooterStatusBar>
        <widgets:FooterStatusBar.LeftContent>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="{StaticResource FontBody}"
                       Foreground="{StaticResource AccentBrush}"
                       Text="{Binding FooterHealthLabel}" />
          </StackPanel>
        </widgets:FooterStatusBar.LeftContent>

        <widgets:FooterStatusBar.RightContent>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="{StaticResource FontBody}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding FooterRunLabel}" />
          </StackPanel>
        </widgets:FooterStatusBar.RightContent>
      </widgets:FooterStatusBar>
    </shells:DevicePanelShell.FooterContent>
  </shells:DevicePanelShell>
</UserControl>
