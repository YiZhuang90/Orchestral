<UserControl x:Class="ExperimentalControlPlatform.App.Shell.DevicePanelShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="ShellRoot">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource ShellDividerBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="11,11,0,0"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
      <Grid Margin="16,0,12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid VerticalAlignment="Center">
          <ContentPresenter x:Name="TitleContentHost"
                            Content="{Binding TitleContent, ElementName=ShellRoot}"
                            DataContext="{Binding DataContext, ElementName=ShellRoot}">
            <ContentPresenter.Style>
              <Style TargetType="ContentPresenter">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ContentPresenter.Style>
          </ContentPresenter>

          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource ShellFontFamily}"
                     FontSize="{StaticResource FontShellTitle}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="{Binding PanelTitle, ElementName=ShellRoot}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Visibility, ElementName=TitleContentHost}" Value="Visible">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Grid Grid.Column="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
          <ContentPresenter x:Name="HeaderContentHost"
                            Content="{Binding HeaderContent, ElementName=ShellRoot}"
                            DataContext="{Binding DataContext, ElementName=ShellRoot}">
            <ContentPresenter.Style>
              <Style TargetType="ContentPresenter">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ContentPresenter.Style>
          </ContentPresenter>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="{StaticResource FontMicro}"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding ContextLabel, ElementName=ShellRoot}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=HeaderContentHost}" Value="Visible">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ContextLabel, ElementName=ShellRoot}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ListBox HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ChannelTabItemStyle}"
                     ItemsSource="{Binding TabsSource, ElementName=ShellRoot}"
                     ItemTemplate="{Binding TabItemTemplate, ElementName=ShellRoot}"
                     SelectedItem="{Binding SelectedTab, ElementName=ShellRoot, Mode=TwoWay}">
              <ListBox.Style>
                <Style TargetType="ListBox">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Content, ElementName=HeaderContentHost}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListBox.Style>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Style="{StaticResource WindowControlButtonStyle}"
                  Click="MinimizeButton_OnClick">
            <iconPacks:PackIconMaterial Kind="Minus" Width="12" Height="12" />
          </Button>
          <Button Style="{StaticResource WindowControlButtonStyle}"
                  Click="MaximizeRestoreButton_OnClick">
            <iconPacks:PackIconMaterial Kind="CheckboxBlankOutline" Width="12" Height="12" />
          </Button>
          <Button Style="{StaticResource CloseWindowControlButtonStyle}"
                  Click="CloseButton_OnClick">
            <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding LeftRailWidth, ElementName=ShellRoot}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource RailBackgroundBrush}"
              Padding="16,16,16,12">
        <ContentPresenter Content="{Binding LeftRailContent, ElementName=ShellRoot}"
                          DataContext="{Binding DataContext, ElementName=ShellRoot}" />
      </Border>

      <ContentPresenter Grid.Column="1"
                        Margin="12,12,12,8"
                        Content="{Binding WorkspaceContent, ElementName=ShellRoot}"
                        DataContext="{Binding DataContext, ElementName=ShellRoot}" />
    </Grid>

    <ContentPresenter Grid.Row="2"
                      Content="{Binding FooterContent, ElementName=ShellRoot}"
                      DataContext="{Binding DataContext, ElementName=ShellRoot}" />
  </Grid>
</UserControl>
