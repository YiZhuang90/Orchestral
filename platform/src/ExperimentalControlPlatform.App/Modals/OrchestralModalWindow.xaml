<Window x:Class="ExperimentalControlPlatform.App.Modals.OrchestralModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:modals="clr-namespace:ExperimentalControlPlatform.App.Modals"
        Title="{Binding ModalTitle}"
        Width="520"
        MinWidth="460"
        SizeToContent="Height"
        Background="Transparent"
        FontFamily="Inter, Segoe UI"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        CornerRadius="18"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#5F5E5E" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E5E9E4" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#D7DBD6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseWindowControlButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#5F5E5E" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#AE532D" />
                <Setter Property="Foreground" Value="#FFF7F5" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#7E351F" />
                <Setter Property="Foreground" Value="#FFF7F5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type modals:DiagnosticsDialogViewModel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="44"
                Height="44"
                Margin="0,2,16,0"
                Background="#F3F4F0"
                CornerRadius="22"
                VerticalAlignment="Top">
          <iconPacks:PackIconMaterial Kind="Stethoscope"
                                      Width="20"
                                      Height="20"
                                      Foreground="#9A462A"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1">
          <TextBlock FontFamily="Manrope, Segoe UI"
                     FontSize="16"
                     Foreground="#2E3430"
                     Text="{Binding Title}" />
          <TextBlock Margin="0,4,0,0"
                     FontSize="12"
                     Foreground="#5A615C"
                     Text="{Binding Subtitle}" />

          <ItemsControl Margin="0,16,0,0"
                        ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type modals:DiagnosticsFieldViewModel}">
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontSize="12"
                             Foreground="#5A615C"
                             Text="{Binding Label}" />
                  <TextBlock Grid.Column="1"
                             FontSize="12"
                             Foreground="#2E3430"
                             TextWrapping="Wrap"
                             Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type modals:CameraSettingsDialogViewModel}">
      <StackPanel>
        <TextBlock FontFamily="Manrope, Segoe UI"
                   FontSize="16"
                   Foreground="#2E3430"
                   Text="Detailed camera settings" />
        <TextBlock Margin="0,4,0,0"
                   FontSize="12"
                   Foreground="#5A615C"
                   Text="{Binding Subtitle}" />

        <TextBlock Margin="0,18,0,0"
                   FontSize="12"
                   Foreground="#5A615C"
                   Text="Trigger mode" />
        <Border Margin="0,6,0,0"
                Background="#FFFFFF"
                BorderBrush="#D8DDD7"
                BorderThickness="1"
                CornerRadius="8">
          <ComboBox ItemsSource="{Binding TriggerModeOptions}"
                    SelectedItem="{Binding SelectedTriggerMode, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,0"
                    Height="34"
                    FontSize="12"
                    FontFamily="Inter, Segoe UI"
                    Foreground="#2E3430"
                    VerticalContentAlignment="Center" />
        </Border>

        <TextBlock Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="#5A615C"
                   Text="Color tone" />
        <Border Margin="0,6,0,0"
                Background="#FFFFFF"
                BorderBrush="#D8DDD7"
                BorderThickness="1"
                CornerRadius="8">
          <ComboBox ItemsSource="{Binding ColorToneOptions}"
                    SelectedItem="{Binding SelectedColorTone, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,0"
                    Height="34"
                    FontSize="12"
                    FontFamily="Inter, Segoe UI"
                    Foreground="#2E3430"
                    VerticalContentAlignment="Center" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type modals:OutputSettingsDialogViewModel}">
      <StackPanel>
        <TextBlock FontFamily="Manrope, Segoe UI"
                   FontSize="16"
                   Foreground="#2E3430"
                   Text="Runtime output settings" />
        <TextBlock Margin="0,4,0,0"
                   FontSize="12"
                   Foreground="#5A615C"
                   Text="{Binding Subtitle}" />

        <TextBlock Margin="0,18,0,0"
                   FontSize="12"
                   Foreground="#5A615C"
                   Text="Payload type" />
        <Border Margin="0,6,0,0"
                Background="#FFFFFF"
                BorderBrush="#D8DDD7"
                BorderThickness="1"
                CornerRadius="8">
          <ComboBox ItemsSource="{Binding PayloadTypeOptions}"
                    SelectedItem="{Binding SelectedPayloadType, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,0"
                    Height="34"
                    FontSize="12"
                    FontFamily="Inter, Segoe UI"
                    Foreground="#2E3430"
                    VerticalContentAlignment="Center" />
        </Border>

        <TextBlock Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="#5A615C"
                   Text="Emission mode" />
        <Border Margin="0,6,0,0"
                Background="#FFFFFF"
                BorderBrush="#D8DDD7"
                BorderThickness="1"
                CornerRadius="8">
          <ComboBox ItemsSource="{Binding EmissionModeOptions}"
                    SelectedItem="{Binding SelectedEmissionMode, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,0"
                    Height="34"
                    FontSize="12"
                    FontFamily="Inter, Segoe UI"
                    Foreground="#2E3430"
                    VerticalContentAlignment="Center" />
        </Border>

        <TextBlock Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="#5A615C"
                   Text="Output frequency (Hz)" />
        <Border Margin="0,6,0,0"
                Background="#FFFFFF"
                BorderBrush="#D8DDD7"
                BorderThickness="1"
                CornerRadius="8">
          <TextBox Background="Transparent"
                   BorderThickness="0"
                   Padding="12,0"
                   Height="34"
                   FontSize="12"
                   FontFamily="Inter, Segoe UI"
                   Foreground="#2E3430"
                   Text="{Binding OutputFrequencyHzInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   VerticalContentAlignment="Center" />
        </Border>

        <CheckBox Margin="0,16,0,0"
                  IsChecked="{Binding IncludeMetadata, Mode=TwoWay}">
          <TextBlock FontSize="12"
                     Foreground="#2E3430"
                     Text="Include metadata" />
        </CheckBox>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border Margin="1"
          Background="#F9F9F6"
          BorderBrush="#D0D4CF"
          BorderThickness="1"
          CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
        <RowDefinition Height="56" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="#F9F9F6"
              BorderBrush="#D8DDD7"
              BorderThickness="0,0,0,1"
              CornerRadius="17,17,0,0"
              MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid Margin="14,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock VerticalAlignment="Center"
                     FontFamily="Manrope, Segoe UI"
                     FontSize="16"
                     Foreground="#2E3430"
                     Text="{Binding ModalTitle}" />

          <Button Grid.Column="1"
                  Style="{StaticResource CloseWindowControlButtonStyle}"
                  Click="CloseButton_OnClick">
            <iconPacks:PackIconMaterial Kind="Close"
                                        Width="10"
                                        Height="10" />
          </Button>
        </Grid>
      </Border>

      <ContentPresenter Grid.Row="1"
                        Margin="18,18,18,12"
                        Content="{Binding ModalContent}" />

      <Border Grid.Row="2"
              Background="#F9F9F6"
              BorderBrush="#D8DDD7"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,17,17">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="1"
                  MinWidth="112"
                  Height="36"
                  Padding="14,6"
                  Background="#6B6A69"
                  BorderThickness="0"
                  Foreground="#FAF7F6"
                  Click="PrimaryButton_OnClick">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                  <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.84" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <TextBlock FontSize="12"
                       Text="{Binding PrimaryButtonText}" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

